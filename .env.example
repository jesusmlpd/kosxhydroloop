# Copia este archivo como .env.local y llena lo que vayas a usar.
# Sin llaves, el checkout sigue funcionando en desarrollo con una corrida
# simulada que no cobra nada. En produccion responde un error claro.

# --- Stripe (tarjeta, Apple Pay, Google Pay, OXXO, SPEI) ---
# Los metodos de pago NO se declaran en el codigo: se prenden en el dashboard
# de Stripe y el checkout usa los que esten activos.
# Apple Pay necesita ademas verificar el dominio en Stripe (Settings > Payments
# > Payment method domains) y servir el archivo de asociacion en
# /.well-known/apple-developer-merchantid-domain-association
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mercado Pago (tarjetas con MSI, saldo, efectivo) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Correo de pedidos y contacto ---
# Buzon real al que llegan pedidos y mensajes. Manda sobre lib/site.ts.
# Recuerda darle clic al mail de "Activate Form" de FormSubmit en el primer
# envio, y que la activacion es por origen (produccion y localhost aparte).
FORMSUBMIT_TO=

# --- Panel interno (/admin: dashboard, pedidos y marketing) ---
# Sin estas variables el panel entra con las credenciales de arranque
# (oscar@kickoffsocial.com / admin). Definelas en produccion antes de
# compartir el sitio; cambiar cualquiera invalida las sesiones abiertas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Marketing (opcionales; sin ID no se inyecta ningun script) ---
# Pixel de Meta: ID numerico del Events Manager. El sitio ya dispara PageView,
# ViewContent, AddToCart, InitiateCheckout y Purchase con monto.
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4: ID de medicion (G-XXXXXXXXXX). Manda los eventos
# equivalentes de ecommerce (view_item, add_to_cart, begin_checkout, purchase).
NEXT_PUBLIC_GA4_ID=
